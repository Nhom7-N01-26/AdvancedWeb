{
  "name": "AdvancedWeb",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "lts"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot"
      ]
    }
  },
  "forwardPorts": [3000, 3001, 3306],
  "portsAttributes": {
    "3000": { "label": "Express API" },
    "3001": { "label": "NestJS API", "onAutoForward": "notify" },
    "3306": { "label": "MySQL" }
  },
  "postCreateCommand": "npm install && npm install --prefix novel"
}
