# ==========================================
# NOVEL MANAGER - BACKEND CONFIGURATION
# ==========================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# OPTION 1: AIVEN CLOUD MYSQL (DÙNG CHUNG NHÓM 7 - KHUYÊN DÙNG)
DB_HOST=advanced-web-3667-elysia.a.aivencloud.com
DB_PORT=19696
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password_here
